      }
    },
    "For live CPU, memory pressure, and per-process measurements, macOS provides Activity Monitor. Mac Guardian will not report a performance score without measuring it." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "For live CPU, memory pressure, and per-process measurements, macOS provides Activity Monitor. Mac Guardian will not report a performance score without measuring it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Para consultar CPU, presión de memoria y procesos en tiempo real, macOS incluye Monitor de Actividad. Mac Guardian no mostrará una puntuación de rendimiento sin medirla." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "CPU、メモリプレッシャー、プロセスごとの情報はアクティビティモニタで確認できます。測定せずに性能スコアを表示することはありません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Para consultar CPU, pressão da memória e processos em tempo real, use o Monitor de Atividade do macOS. O Mac Guardian não exibirá uma pontuação de desempenho sem medições." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 活动监视器可查看实时 CPU、内存压力和进程数据。未经测量，Mac Guardian 不会显示性能评分。" } }
      }
    },
    "Open Activity Monitor" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Activity Monitor" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Monitor de Actividad" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクティビティモニタを開く" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Monitor de Atividade" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开活动监视器" } }
      }
    },
    "Persistence Audit" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Persistence Audit" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Auditoría de inicio" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "起動項目の監査" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Auditoria de inicialização" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动项审计" } }
      }
    },
    "Inventory launch definitions in common user and third-party system folders. Presence alone does not mean an item is malicious or running." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inventory launch definitions in common user and third-party system folders. Presence alone does not mean an item is malicious or running." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Enumera definiciones de inicio comunes del usuario y de terceros. Su presencia no significa que sean maliciosas ni que estén ejecutándose." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ユーザーおよびサードパーティの一般的な起動定義を一覧表示します。存在するだけで悪意がある、または実行中とは限りません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lista definições de inicialização comuns do usuário e de terceiros. A presença não significa que sejam maliciosas ou estejam em execução." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "列出常见的用户和第三方启动定义。项目存在并不代表其恶意或正在运行。" } }
      }
    },
    "No launch definitions found" : {
