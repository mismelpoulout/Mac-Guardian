    "Application removal plans are not available yet. This inventory does not change apps." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Application removal plans are not available yet. This inventory does not change apps." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los planes para desinstalar aplicaciones aún no están disponibles. Este inventario no modifica las apps." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリ削除プランはまだ利用できません。この一覧でアプリが変更されることはありません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os planos de remoção de aplicativos ainda não estão disponíveis. Este inventário não altera os apps." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用卸载计划尚未推出。此清单不会更改任何应用。" } }
      }
    },
    "macOS does not provide a public API to read a complete inventory of all app privacy grants. Mac Guardian will not inspect the protected TCC database or claim permission states it cannot verify." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS does not provide a public API to read a complete inventory of all app privacy grants. Mac Guardian will not inspect the protected TCC database or claim permission states it cannot verify." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "macOS no ofrece una API pública para consultar todos los permisos de privacidad de las apps. Mac Guardian no leerá la base TCC protegida ni afirmará estados que no pueda verificar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "macOSにはアプリのプライバシー許可をすべて取得する公開APIがありません。保護されたTCCデータベースを調べたり、確認できない許可状態を断定したりしません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O macOS não oferece uma API pública para consultar todas as permissões de privacidade dos apps. O Mac Guardian não acessará o banco TCC protegido nem afirmará estados que não possa verificar." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 未提供查询所有应用隐私授权的公共 API。Mac Guardian 不会读取受保护的 TCC 数据库，也不会声称无法验证的权限状态。" } }
      }
    },
    "Permission states not available through public macOS APIs are shown as unknown." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission states not available through public macOS APIs are shown as unknown." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los permisos que no se pueden consultar mediante APIs públicas de macOS se muestran como desconocidos." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "公開macOS APIで確認できない許可状態は「不明」と表示します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Permissões que não podem ser consultadas por APIs públicas do macOS aparecem como desconhecidas." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法通过 macOS 公共 API 获取的权限状态会显示为未知。" } }
      }
    },
