        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Application" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir aplicación" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリを開く" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir aplicativo" } },
