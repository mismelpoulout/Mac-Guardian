      }
    },
    "This inventory does not disable or remove any startup item." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This inventory does not disable or remove any startup item." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Este inventario no desactiva ni elimina elementos de inicio." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この一覧は起動項目を無効化または削除しません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este inventário não desativa nem remove itens de inicialização." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此清单不会停用或移除任何启动项。" } }
      }
    },
    "error.persistenceAuditFailed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not read startup definitions. Check folder permissions and try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron leer las definiciones de inicio. Revisa los permisos de las carpetas e inténtalo de nuevo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "起動定義を読み取れませんでした。フォルダのアクセス権を確認して再試行してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível ler as definições de inicialização. Verifique as permissões das pastas e tente novamente." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取启动定义。请检查文件夹权限后重试。" } }
      }
    },
    "Review direct items in your user cache. Select an item to move it to Trash; close its app first. Nothing is permanently erased by Mac Guardian." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review direct items in your user cache. Select an item to move it to Trash; close its app first. Nothing is permanently erased by Mac Guardian." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa los elementos de la caché de tu usuario. Puedes enviar un elemento a la Papelera; cierra antes la app que lo usa. Mac Guardian no elimina nada permanentemente." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Revise os itens do cache do usuário. Você pode enviar um item para o Lixo; feche antes o app que o utiliza. O Mac Guardian não apaga nada permanentemente." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看用户缓存中的项目。可选择将项目移到废纸篓；请先关闭正在使用它的应用。Mac Guardian 不会永久删除任何内容。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ユーザーキャッシュ内の項目を確認できます。項目をゴミ箱に移動する前に、使用中のアプリを終了してください。Mac Guardian が完全削除することはありません。" } }
      }
    },
    "Analyzing user caches…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Analyzing user caches…" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Analizando cachés del usuario…" } },
